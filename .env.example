# PostgreSQL with pgvector connection string (e.g. Neon.tech, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:password.supabase.co:5432/postgres"

# Anthropic API Key (used for Claude streaming responses)
ANTHROPIC_API_KEY="sk-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
ANTHROPIC_WORKSPACE_ID="workspace

# Cohere API Key and Embedding Model (used for generating embeddings)
COHERE_API_KEY="..."
COHERE_EMBEDDING_MODEL="embed-v4.0"

# Server Configuration
PORT=5000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# Gemini API Key (used for Gemini streaming responses)
GEMINI_API_KEY="..."
GEMINI_MODEL="gemini-3.6-flash"