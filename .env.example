# PostgreSQL with pgvector connection string (e.g. Neon.tech, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/rag_db"

# Anthropic API Key (used for Claude streaming responses)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
ANTHROPIC_WORKSPACE_ID="your-workspace-id"

# Server Configuration
PORT=5000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

#ollama API Key (used for LLaMA 2 streaming responses)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"